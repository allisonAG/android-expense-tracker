<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expense Tracker"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/charcoal"
            android:letterSpacing="-0.02"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:background="@color/rose_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="20dp"
            android:orientation="vertical"
            android:background="@drawable/total_card_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL EXPENSES"
                android:textColor="@color/rose_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/totalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Total: $0.00"
                android:textColor="@color/card_white"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:text="Recent Expenses"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/charcoal" />

        <LinearLayout
            android:id="@+id/expensesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/category_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BY CATEGORY"
                android:textColor="@color/rose_light"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/categoryTotalsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/card_white"
                android:textSize="16sp" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/addExpenseButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="Add Expense"
            android:textColor="@color/card_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/add_button_background"
            app:backgroundTint="@null"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
